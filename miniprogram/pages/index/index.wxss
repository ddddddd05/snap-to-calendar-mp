.page {
  padding: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 26rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 18rpx rgba(15, 23, 42, 0.05);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
}

.mode-group {
  display: flex;
  background: #f1f5f9;
  border-radius: 12rpx;
  padding: 4rpx;
}

.mode-pill {
  padding: 8rpx 18rpx;
  font-size: 24rpx;
  color: #64748b;
  border-radius: 10rpx;
}

.mode-pill.active {
  background: #ffffff;
  color: #4f46e5;
  font-weight: 600;
}

.upload-box {
  border: 2rpx dashed #cbd5e1;
  border-radius: 16rpx;
  background: #f8fafc;
  padding: 40rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}

.upload-icon {
  font-size: 54rpx;
  margin-bottom: 10rpx;
}

.upload-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #0f172a;
}

.upload-sub {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 6rpx;
}

.preview-box {
  position: relative;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 12rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.preview-img {
  width: 100%;
  height: 300rpx;
}

.clear-btn {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(15, 23, 42, 0.65);
  color: #ffffff;
  font-size: 26rpx;
}

.text-area {
  width: 100%;
  height: 160rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  padding: 18rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  margin-bottom: 20rpx;
}

.btn-primary {
  background: #4f46e5;
  color: #ffffff;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.btn-success {
  background: #059669;
  color: #ffffff;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.demo-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed #e2e8f0;
}

.demo-label {
  font-size: 24rpx;
  color: #64748b;
}

.demo-btn {
  font-size: 24rpx;
  background: #eef2ff;
  color: #4f46e5;
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
}

.tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background: #f8fafc;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #64748b;
  font-weight: 600;
}

.tab.active {
  background: #eef2ff;
  color: #4f46e5;
}

.empty {
  text-align: center;
  padding: 48rpx 20rpx;
  color: #94a3b8;
  font-size: 26rpx;
}

.event-item {
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.event-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}

.event-title {
  font-size: 28rpx;
  font-weight: 700;
  flex: 1;
}

.btn-mini-add {
  background: #ecfdf5;
  color: #059669;
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.event-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #475569;
}

.event-note {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.total-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
  font-size: 28rpx;
}

.total-num {
  color: #dc2626;
  font-weight: 700;
  font-size: 32rpx;
}

.btn-mini-export {
  background: #059669;
  color: #ffffff;
  padding: 10rpx 20rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.exp-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 12rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.exp-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.exp-name {
  font-size: 28rpx;
  font-weight: 600;
}

.exp-sub {
  font-size: 22rpx;
  color: #64748b;
}

.exp-amount {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}
